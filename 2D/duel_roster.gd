static func ladder_for(character: int) -> Array[int]:
	var rivals: Array[int] = [RIVALS[character]]
	for index in PLAYABLE_COUNT:
		if index != character and index != rivals[0]:
			rivals.append(index)
	rivals.append(HONG)
	return rivals
